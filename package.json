{
  "name": "pi-better-show",
  "version": "0.6.0",
  "description": "Interactive blocks for agent-written Markdown: one vocabulary, text fallback, and answer encoding shared by every host, plus the show_doc extension for pi",
  "type": "module",
  "license": "MIT",
  "author": "wayne930242",
  "bin": {
    "pbs-tree": "./bin/pbs-tree.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/core/index.ts",
    "./elements": "./src/elements/index.ts",
    "./react": "./src/react/index.ts",
    "./server": "./src/server/index.ts",
    "./extension": "./src/extension/index.ts"
  },
  "scripts": {
    "test": "bun test",
    "check": "tsc --noEmit && tsc -p tsconfig.core.json && biome check .",
    "demo": "bun examples/serve.ts",
    "show": "bun examples/show-harness.ts"
  },
  "dependencies": {
    "beautiful-mermaid": "1.1.3",
    "esbuild": "0.28.2",
    "markdown-it": "15.0.3",
    "pbs-page-react": "npm:react@19.3.1",
    "pbs-page-react-dom": "npm:react-dom@19.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@happy-dom/global-registrator": "21.0.4",
    "@types/bun": "1.4.4",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "21.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typebox": "1.4.5",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wayne930242/pi-better-show.git"
  },
  "keywords": [
    "pi-package",
    "pi",
    "markdown",
    "blocks",
    "mermaid",
    "form",
    "chat",
    "web-components",
    "react",
    "custom-elements"
  ],
  "peerDependencies": {
    "react": ">=19",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./src/extension/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/wayne930242/pi-better-show/main/docs/images/decide.png"
  }
}
